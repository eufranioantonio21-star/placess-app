generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  authUserId String? @unique
  email     String   @unique
  // Transitional only: kept nullable so the legacy hashes are not destroyed.
  // New authentication is handled by Supabase Auth.
  password  String?
  name      String
  phoneNumber String?
  role      String   @default("CONSUMER") // "CONSUMER" or "BUSINESS"
  photoUrl  String?
  initials  String?
  preferences String? @default("{}")
  adultConfirmedAt DateTime?
  deletionRequestedAt DateTime?
  createdAt DateTime @default(now())
  
  // Relations
  places    Place[]  // If Business Owner
  orders    Order[]  // If Consumer
  reviews   Review[]
  notifications Notification[]
  staffMemberships PlaceMembership[]
  campaignClicks CampaignClick[]
}

model RevokedSession {
  id        String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Place {
  id              Int      @id @default(autoincrement())
  name            String
  category        String
  description     String?
  keywords        String?
  lat             Float
  lng             Float
  phoneNumber     String?
  photoUrl        String?
  capacity        String?  // e.g., "45% Full"
  takeAwayEnabled Boolean  @default(true)
  ownerId         Int
  createdAt       DateTime @default(now())

  // Relations
  owner           User     @relation(fields: [ownerId], references: [id])
  menuItems       MenuItem[]
  campaigns       Campaign[]
  orders          Order[]
  reviews         Review[]
  staffMemberships PlaceMembership[]
}

model PlaceMembership {
  id                 Int      @id @default(autoincrement())
  placeId            Int
  userId             Int
  canManageOrders    Boolean  @default(false)
  canManageCampaigns Boolean  @default(false)
  canManageMenu      Boolean  @default(false)
  canViewMetrics     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
  @@index([userId])
}

model BusinessAuditEvent {
  id           Int      @id @default(autoincrement())
  actorUserId  Int
  placeId      Int
  targetUserId Int?
  action       String
  detailsJson  String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([placeId, createdAt])
  @@index([actorUserId, createdAt])
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  available   Boolean  @default(true)
  image       String?
  placeId     Int
  createdAt   DateTime @default(now())

  // Relations
  place       Place    @relation(fields: [placeId], references: [id])
}

model CampaignClick {
  id         Int      @id @default(autoincrement())
  campaignId Int
  userId     Int
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId, createdAt])
}

model Campaign {
  id          Int      @id @default(autoincrement())
  type        String   // "discount", "reward", "happy_hour"
  title       String
  description String
  isActive    Boolean  @default(true)
  radiusKm    Float    @default(1)
  durationHours Int    @default(24)
  estimatedPriceAoa Int @default(0)
  isSynthetic Boolean  @default(false)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  placeId     Int
  createdAt   DateTime @default(now())

  // Relations
  place       Place    @relation(fields: [placeId], references: [id])
  clicksByUser CampaignClick[]
}

model Order {
  id          Int      @id @default(autoincrement())
  status      String   @default("pending") // "pending", "ready", "completed"
  total       Float
  userId      Int
  placeId     Int
  itemsJson   String   // Storing JSON string for simplicity in MVP
  clientRequestId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id])
  place       Place    @relation(fields: [placeId], references: [id])

  @@unique([userId, clientRequestId])
}

model Review {
  id          Int      @id @default(autoincrement())
  rating      Int      // 1 to 5
  comment     String?
  userId      Int
  placeId     Int
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id])
  place       Place    @relation(fields: [placeId], references: [id])

  @@unique([userId, placeId])
}
model Notification {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  type        String   @default("SYSTEM") // "SYSTEM", "OFFER", "ALERT"
  isRead      Boolean  @default(false)
  userId      Int
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id])
}

